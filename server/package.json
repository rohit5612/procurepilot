{
  "name": "erp-server",
  "version": "1.0.0",
  "description": "ERP System Backend - PERN Stack with RBAC",
  "type": "module",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "test": "node --experimental-vm-modules node_modules/jest/bin/jest.js",
    "test:watch": "jest --watch",
    "test:hr:smoke": "node scripts/hr_smoke_test.js",
    "migrate": "node scripts/db/migrate-prisma.js",
    "db:compose": "node scripts/db/compose-prisma-migrations.js",
    "db:migrate": "node scripts/db/migrate-prisma.js",
    "db:numbering": "node scripts/db/apply-document-numbering.js",
    "db:demo-reset": "node scripts/db/reset-demo-procurement.js",
    "db:demo-rbac-reset": "node scripts/db/reset-demo-org-rbac.js",
    "db:demo-user-hygiene": "node scripts/db/reset-demo-user-hygiene.js",
    "db:seed-demo-users": "node scripts/db/seed-demo-test-users.js",
    "db:refresh-role-matrix": "node scripts/db/refresh-role-matrix.js",
    "db:baseline": "node scripts/db/baseline-prisma.js",
    "ensure:inventory": "node scripts/setup/ensureInventoryTables.js",
    "ensure:stockcount": "node scripts/setup/ensureStockCount.js",
    "seed": "node scripts/setup/seed.js",
    "seed:inventory-demo": "node scripts/setup/seed_inventory_demo.js",
    "seed:demo-users": "node scripts/setup/seed_demo_users.js",
    "check:inventory": "node scripts/setup/checkInventoryTables.js",
    "setup": "npm run migrate && npm run seed",
    "create-superuser": "node scripts/setup/createSuperuser.js",
    "apply:circles": "node scripts/setup/apply_circles_migration.js",
    "cleanup:database": "node scripts/setup/cleanupDatabase.js",
    "seed:categories": "node scripts/setup/seed_item_categories.js",
    "import:items": "node scripts/setup/import_items_from_csv.js"
  },
  "dependencies": {
    "@prisma/client": "^6.19.0",
    "@aws-sdk/client-s3": "^3.967.0",
    "axios": "^1.11.0",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "csv-parse": "^6.1.0",
    "dotenv": "^16.3.1",
    "exceljs": "^4.4.0",
    "express": "^4.18.2",
    "express-rate-limit": "^7.1.5",
    "express-validator": "^7.0.1",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.0",
    "multer": "^2.0.2",
    "node-fetch": "^3.3.2",
    "nodemailer": "^6.9.7",
    "pdf-lib": "^1.17.1",
    "pg": "^8.11.3",
    "redis": "^4.6.10",
    "uuid": "^9.0.1",
    "winston": "^3.11.0"
  },
  "devDependencies": {
    "@types/jest": "^29.5.8",
    "prisma": "^6.19.0",
    "jest": "^29.7.0",
    "nodemon": "^3.0.2",
    "supertest": "^6.3.3"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "jest": {
    "testEnvironment": "node",
    "transform": {}
  },
  "keywords": [
    "erp",
    "rbac",
    "pern",
    "postgresql",
    "express",
    "react",
    "nodejs"
  ],
  "author": "ERP Development Team",
  "license": "MIT"
}
