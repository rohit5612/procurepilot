# =============================================================================
# ProcurePilot — server environment (copy to .env)
# =============================================================================

# --- Core ---
PORT=5000
NODE_ENV=development
BACKEND_URL=http://localhost:5000

# --- PostgreSQL ---
DB_HOST=localhost
DB_PORT=5432
DB_NAME=procurepilot
DB_USER=postgres
DB_PASSWORD=change-me
DATABASE_URL=postgresql://postgres:change-me@localhost:5432/procurepilot?schema=public
# One-shot on Render after a failed migrate left partial schema (then remove):
# PRISMA_MIGRATE_RESET_PUBLIC=1

# --- Auth / JWT ---
JWT_SECRET=change-me-long-random-string
JWT_EXPIRES_IN=24h
JWT_REFRESH_SECRET=
JWT_REFRESH_EXPIRES_IN=7d

# --- CORS & frontend links ---
CORS_ORIGIN=http://localhost:5173
FRONTEND_URL=http://localhost:5173
# Render (hackathon demo): e.g. CORS_ORIGIN=https://procurepilot-01w3.onrender.com
# FRONTEND_URL=https://procurepilot-01w3.onrender.com
SUPPORT_EMAIL=support@example.com

# --- GRN (goods receipt) ---
# Skip inventory layer posting on GRN post until inventory module is enabled (default: true)
PROCUREPILOT_GRN_SKIP_INVENTORY=true

# --- Redis (permissions cache, sessions) ---
REDIS_URL=redis://localhost:6379

# --- File storage ---
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=./storage
MAX_FILE_SIZE=10485760
# S3 (when STORAGE_DRIVER=s3)
S3_BUCKET=
S3_REGION=ap-south-1
AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
S3_KMS_KEY_ID=

# --- Email (optional) ---
# Keep false for demo/E2E — supplier PO mail is disabled in app; user mail still respects this flag.
EMAIL_ENABLED=false
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_SECURE=false
EMAIL_REQUIRE_TLS=true
EMAIL_USER=
EMAIL_PASS=
EMAIL_FROM=noreply@localhost
EMAIL_SUBJECT_PREFIX=[ProcurePilot]
EMAIL_CONNECTION_TIMEOUT=15000
EMAIL_SOCKET_TIMEOUT=15000
EMAIL_GREETING_TIMEOUT=10000
EMAIL_TLS_REJECT_UNAUTHORIZED=true

# --- ERP / procurement toggles ---
ENABLE_HR_API=false
REQUIRE_PR_EMAIL_ATTACHMENT=false
LIBREOFFICE_PATH=

# =============================================================================
# AI (extraction + explanations)
# =============================================================================
# ollama | openai_compatible
AI_PROVIDER=ollama

# --- Ollama (pick cloud OR local) ---
# Cloud: key from https://ollama.com/settings/keys, no local daemon
OLLAMA_API_KEY=
OLLAMA_BASE_URL=https://ollama.com
OLLAMA_MODEL=llama3.2
# Local: ollama serve + ollama pull <model> (leave OLLAMA_API_KEY empty)
# OLLAMA_BASE_URL=http://localhost:11434

# --- openai_compatible only (set AI_PROVIDER=openai_compatible) ---
# AI_AGENT_API_KEY=
# OPENAI_COMPATIBLE_BASE_URL=https://api.openai.com/v1
# AI_MODEL=gpt-4o-mini

# Behavior
AI_REQUEST_TIMEOUT_MS=120000
AI_EXTRACTION_TEMPERATURE=0.1
AI_EXPLAIN_TEMPERATURE=0.4
# When true, use rule-based extraction if LLM fails (recommended for demos)
AI_FALLBACK_HEURISTICS=true

# =============================================================================
# Channel3 (product search / offers) — optional
# =============================================================================
CHANNEL3_ENABLED=false
CHANNEL3_API_BASE_URL=https://api.trychannel3.com
CHANNEL3_API_KEY=
CHANNEL3_SEARCH_LIMIT=12
CHANNEL3_USD_TO_INR=83

# =============================================================================
# PayPal Checkout (Sandbox for hackathon)
# =============================================================================
PAYPAL_ENABLED=false
PAYPAL_MODE=sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# Public client id for frontend SDK (often same as PAYPAL_CLIENT_ID in sandbox)
PAYPAL_PUBLIC_CLIENT_ID=
PAYPAL_WEBHOOK_ID=
# Return URLs after checkout (defaults use FRONTEND_URL if empty)
PAYPAL_RETURN_URL=
PAYPAL_CANCEL_URL=
# Checkout currency (USD for global sandbox; INR if your PayPal merchant supports it)
PAYPAL_CHECKOUT_CURRENCY=USD
PAYPAL_INR_TO_USD_RATE=83

# =============================================================================
# ProcurePilot feature flags
# =============================================================================
PROCUREPILOT_DEMO_OFFERS=true
PROCUREPILOT_PERSIST_AI_BUY=true
