# ProcurePilot — Vite client (copy to .env)

# API base (no trailing slash on /api — client appends paths)
VITE_API_URL=http://localhost:5000

# Optional: override if different from server CORS origin
VITE_APP_URL=http://localhost:5173

# PayPal JS SDK (sandbox client id — safe to expose in browser)
VITE_PAYPAL_CLIENT_ID=
VITE_PAYPAL_ENABLED=false

# UI feature flags
VITE_ENABLE_HR_UI=false
